# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

Include ~/.ssh/config.d/*.conf
Include ~/.ssh/config.d/private/*.conf

Host github.com codeberg.org
  User git
  UserKnownHostsFile ~/.ssh/known_hosts.services
  IdentityAgent SSH_AUTH_SOCK
  IdentitiesOnly yes
  PubkeyAuthentication yes
  PreferredAuthentications publickey
  PasswordAuthentication no
  KbdInteractiveAuthentication no
  StrictHostKeyChecking yes

# ~/.ssh/id_rsa is public material: the private half lives in gpg-agent. Offer
# it only when the agent holds it, so a host without it (a Coder workspace,
# where `coder gitssh` passes its own key with -i) skips straight to a key that
# can sign instead of failing with "Load key ... invalid format".
Match host github.com,codeberg.org exec "%d/.local/bin/ssh-agent-has-key %d/.ssh/id_rsa"
  IdentityFile ~/.ssh/id_rsa

Host *
  IdentityAgent none
  IdentityFile none
  IdentitiesOnly yes
  PubkeyAuthentication no
  PasswordAuthentication no
  KbdInteractiveAuthentication no
  ForwardAgent no
  ForwardX11 no
  ClearAllForwardings yes
  StrictHostKeyChecking yes
  UserKnownHostsFile ~/.ssh/known_hosts
  CanonicalizeHostname no
  VerifyHostKeyDNS no
