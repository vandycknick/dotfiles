# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

Include ~/.ssh/config.d/*.conf
Include ~/.ssh/config.d/private/*.conf

Host github.com codeberg.org
  User git
  UserKnownHostsFile ~/.ssh/known_hosts.services
  IdentitiesOnly yes
  PubkeyAuthentication yes
  PreferredAuthentications publickey
  PasswordAuthentication no
  KbdInteractiveAuthentication no
  StrictHostKeyChecking yes

# A Coder workspace writes its GitHub key here on every boot. `coder gitssh`
# only covers git's core.sshCommand, and tools that set GIT_SSH_COMMAND
# themselves (lazy.nvim forces `ssh -oBatchMode=yes`) bypass it, so plain ssh
# has to find the key on its own.
Match host github.com exec "test -r %d/.ssh/git-commit-signing/coder" !exec "test \"$MACHINE_IDENTITY\" = agent"
  IdentityFile ~/.ssh/git-commit-signing/coder

# Both keys live in the one gpg-agent. Agent contexts (wrapped coding agents,
# agent machines) try the agent key first and fall back to the YubiKey, which
# asks for its PIN; personal sessions use only the YubiKey.
Match host github.com,codeberg.org,192.168.10.* exec "test \"$MACHINE_IDENTITY\" = agent"
  IdentityAgent SSH_AUTH_SOCK
  IdentityFile ~/.ssh/agent_ed25519.pub
  IdentityFile ~/.ssh/id_rsa

Match host github.com,codeberg.org,192.168.10.* !exec "test \"$MACHINE_IDENTITY\" = agent"
  IdentityAgent SSH_AUTH_SOCK
  IdentityFile ~/.ssh/id_rsa

Host *
  IdentityAgent none
  IdentityFile none
  IdentitiesOnly yes
  PubkeyAuthentication no
  PasswordAuthentication no
  KbdInteractiveAuthentication no
  ForwardAgent no
  ForwardX11 no
  ClearAllForwardings yes
  StrictHostKeyChecking yes
  UserKnownHostsFile ~/.ssh/known_hosts
  CanonicalizeHostname no
  VerifyHostKeyDNS no
