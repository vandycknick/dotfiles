Include ~/.ssh/config.d/*
Include ~/.ssh/config.d/private/*

Host github.com
  HostName github.com
  User git
  IdentitiesOnly no
  IdentityFile ~/.ssh/id_rsa

Host codeberg.org
  HostName codeberg.org
  User git
  IdentitiesOnly no
  IdentityFile ~/.ssh/id_rsa

