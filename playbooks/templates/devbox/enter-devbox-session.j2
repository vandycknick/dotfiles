#!/usr/bin/env bash
set -euo pipefail

export HOME={{ devbox_home }}
export USER={{ devbox_user }}
export LOGNAME={{ devbox_user }}
export SHELL=/bin/bash
cd "$HOME"

readonly forwarded_gpg_socket="$HOME/.ssh/forwarded/S.gpg-agent"
readonly standard_gpg_socket="$HOME/.gnupg/S.gpg-agent"
if [[ -S "$forwarded_gpg_socket" ]]; then
    rm -f -- "$standard_gpg_socket"
    ln -s -- "$forwarded_gpg_socket" "$standard_gpg_socket"
fi

if [[ -n "${SSH_ORIGINAL_COMMAND:-}" ]]; then
    if [[ "$SSH_ORIGINAL_COMMAND" == internal-sftp ]]; then
        exec /usr/lib/ssh/sftp-server
    fi
    exec /bin/bash -lc "$SSH_ORIGINAL_COMMAND"
fi

exec /bin/bash -l
