#!/bin/sh

set -eu

[ "$(uname -s)" = "Darwin" ] || {
    printf 'error: macOS defaults can only be configured on macOS\n' >&2
    exit 1
}

defaults write com.apple.finder DesktopViewSettings -dict-add GroupBy Kind
FINDER_PLIST="$HOME/Library/Preferences/com.apple.finder.plist"
if ! plutil -replace DesktopViewSettings.IconViewSettings.arrangeBy \
    -string dateAdded "$FINDER_PLIST" 2>/dev/null; then
    if ! plutil -insert DesktopViewSettings.IconViewSettings.arrangeBy \
        -string dateAdded "$FINDER_PLIST" 2>/dev/null; then
        plutil -insert DesktopViewSettings.IconViewSettings \
            -dictionary "$FINDER_PLIST"
        plutil -insert DesktopViewSettings.IconViewSettings.arrangeBy \
            -string dateAdded "$FINDER_PLIST"
    fi
fi
defaults write com.apple.dock expose-group-apps -bool true

killall Finder 2>/dev/null || true
killall Dock 2>/dev/null || true
