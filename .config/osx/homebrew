#!/bin/sh

set -eu

[ "$(uname -s)" = "Darwin" ] || {
    printf 'error: Homebrew applications are only supported on macOS\n' >&2
    exit 1
}

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
BREWFILE=${BREWFILE:-"$SCRIPT_DIR/Brewfile"}

find_brew() {
    if command -v brew >/dev/null 2>&1; then
        command -v brew
    elif [ -x /opt/homebrew/bin/brew ]; then
        printf '%s\n' /opt/homebrew/bin/brew
    elif [ -x /usr/local/bin/brew ]; then
        printf '%s\n' /usr/local/bin/brew
    else
        return 1
    fi
}

if ! BREW=$(find_brew); then
    printf '\n==> Installing Homebrew for macOS applications\n'
    NONINTERACTIVE=1 /bin/bash -c \
        "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    BREW=$(find_brew) || {
        printf 'error: Homebrew was installed but cannot be found\n' >&2
        exit 1
    }
fi

case "${1:-install}" in
    install)
        "$BREW" bundle --file="$BREWFILE"
        ;;
    update)
        "$BREW" update
        "$BREW" bundle --file="$BREWFILE"
        "$BREW" upgrade --cask
        ;;
    check)
        "$BREW" bundle check --file="$BREWFILE"
        ;;
    *)
        printf 'Usage: %s [install|update|check]\n' "$0" >&2
        exit 2
        ;;
esac
