# Login profile for sh, bash, and zsh. Home Manager prepends the shared session
# variables (modules/shell); only runtime logic belongs here.

# if running bash
if [ -n "$BASH_VERSION" ]; then
    # include .bashrc if it exists
    if [ -f "$HOME/.bashrc" ]; then
	. "$HOME/.bashrc"
    fi
fi

# User commands and the Home Manager profile own the interactive CLI path.
# Prepended here because home.sessionPath appends, and the ~/.local/bin
# wrappers must shadow the Nix binaries they wrap.
PATH="$HOME/.local/bin:$HOME/.nix-profile/bin:$PATH"
export PATH

case "${MACHINE_IDENTITY:-}" in
    agent)
        SSH_AUTH_SOCK=$("$HOME/.local/bin/with-agent" printenv SSH_AUTH_SOCK) || return 1
        if [ -z "$SSH_AUTH_SOCK" ]; then
            echo 'machine-identity: empty agent socket' >&2
            return 1
        fi
        export SSH_AUTH_SOCK
        export GIT_CONFIG_GLOBAL="$HOME/.config/git/agent"
        export GIT_SSH_COMMAND=ssh
        ;;
    personal) ;;
    *)
        echo 'machine-identity: expected personal or agent' >&2
        return 1
        ;;
esac
