# Login profile for sh, bash, and zsh. Home Manager prepends the shared session
# variables and the gpg-agent socket (modules/shell); only runtime logic
# belongs here.

# if running bash
if [ -n "$BASH_VERSION" ]; then
    # include .bashrc if it exists
    if [ -f "$HOME/.bashrc" ]; then
	. "$HOME/.bashrc"
    fi
fi

# The Home Manager profile comes first. ~/.local/bin, where other installers
# (Tern, curl scripts) drop binaries, comes after it so it cannot shadow Nix
# tools; both are moved even when an inherited PATH already lists them.
PATH=$(printf '%s' "$PATH" | tr ':' '\n' |
    grep -vxF -e "$HOME/.nix-profile/bin" -e "$HOME/.local/bin" | paste -sd: -)
PATH="$HOME/.nix-profile/bin${PATH:+:$PATH}:$HOME/.local/bin"
export PATH

# Agent contexts select the agent Git config, which signs with the agent key;
# .ssh/config picks the SSH key from MACHINE_IDENTITY.
case "${MACHINE_IDENTITY:-}" in
    agent)
        export GIT_CONFIG_GLOBAL="$HOME/.config/git/agent"
        export GIT_SSH_COMMAND=ssh
        ;;
    personal) ;;
    *)
        echo 'machine-identity: expected personal or agent' >&2
        return 1
        ;;
esac
