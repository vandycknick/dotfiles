[include]
    path = config
[core]
    sshCommand = ssh
[gpg]
    format = ssh
[user]
    signingKey = ~/.ssh/agent_ed25519.pub
[commit]
    gpgSign = true
[gpg "ssh"]
    allowedSignersFile = ~/.ssh/agent_ed25519.allowed_signers
[url "git@github.com:"]
    insteadOf = https://github.com/
[url "git@codeberg.org:"]
    insteadOf = https://codeberg.org/
