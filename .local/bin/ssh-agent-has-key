#!/bin/sh

#
# ssh-agent-has-key(1) - Succeed when the SSH agent holds the given public key
#
# Usage: ssh-agent-has-key PUBLIC_KEY_FILE
#
# Used by ~/.ssh/config to offer a personal key only on hosts where an agent
# can actually sign with it.
#

[ "$#" -eq 1 ] || exit 2
key=$(cut -d ' ' -f 2 "$1" 2>/dev/null) || exit 1
[ -n "$key" ] || exit 1
ssh-add -L 2>/dev/null | grep -qF -- "$key"
