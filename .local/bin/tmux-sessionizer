#!/usr/bin/env bash
# -e : Stop script on None Zero Exit Code (NZEC)
# -u : Stop script if unbound variable found (use ${var:-} if intentional)
# -o pipefail : By default cmd1 | cmd2 returns exit code of cmd2 regardless of cmd1 success
set -euo pipefail
IFS=$'\n\t'

usage() {
    cat 1>&2 <<EOF
tmux-sessionizer [OPTION]
Start a tmux session from a local folder or an ssh host.

The picker lists both. Folders open a local session, hosts are handed to
tmux-ssh, which owns the remote connection.

USAGE: tmux-sessionizer [FLAGS] [OPTIONS]

FLAGS:
    -h|--help         Show command line help.

OPTIONS:
    -w|--workspace    A list of folders that contain projects.
EOF
}

# The cloud matches the remote marker in the tmux status bar.
folder_icon=''
remote_icon='󰅟'

candidates() {
    # Folders first so they sit closest to the prompt.
    find ~/Projects ~/Work -mindepth 1 -maxdepth 1 -type d 2> /dev/null \
        | (cat; echo "$HOME/.dotfiles") \
        | sed "s|^|$folder_icon |"
    # The folder emoji is two columns wide and the cloud is one, so the
    # cloud gets an extra space to keep both columns aligned.
    tmux-ssh --list 2> /dev/null | sed "s|^|$remote_icon  |"
}

tmux-sessionizer() {
    local selected="${1:-}"
    local tmux="${TMUX:-}"

    if [[ -z "$selected" ]]; then
        set +e # Disable failing on NZEC, if a directory doesn't exist find returns a NZEC. We just don't care about it.
        selected=$(candidates \
            | fzf --style=minimal --padding=1 --scheme=path \
                  --color=bg+:-1,gutter:-1 --ghost 'search sessions')
        set -e

        if [[ -z $selected ]]; then
            return 0
        fi

        local icon="${selected%%[[:space:]]*}"
        selected="${selected#"$icon"}"
        selected="${selected#"${selected%%[![:space:]]*}"}"

        if [[ "$icon" == "$remote_icon" ]]; then
            tmux-ssh "$selected"
            return 0
        fi
    fi

    if [[ -z $selected ]]; then
        return 0
    fi

    local selected_name
    local tmux_running

    selected_name=$(basename "$selected" | tr . _)
    tmux_running=$(pgrep tmux || true)

    if [[ -z "$tmux" ]] && [[ -z "$tmux_running" ]]; then
        tmux new-session -s "$selected_name" -c "$selected"
        return 0
    fi

    if ! tmux has-session -t="$selected_name" 2> /dev/null; then
        tmux new-session -ds "$selected_name" -c "$selected"
    fi

    if [[ -z "$tmux" ]]; then
        tmux attach -t "$selected_name"
    else
        tmux switch-client -t "$selected_name"
    fi

    return 0
}

main() {
    local workspace=""
    local help=false

    while [[ $# -gt 0 ]]; do
       case "$1" in
            -h | --help)
                help=true
                shift
                ;;
            -w | --workspace)
                [[ $# -ge 2 ]] || { usage; exit 2; }
                workspace="$2"
                shift 2
                ;;
            --)
                shift
                break
                ;;
            *)
                printf 'error: unknown option: %s\n' "$1" >&2
                usage
                exit 2
                ;;
       esac
    done

    if [ "$help" = true ]; then
        usage
        exit 0
    fi

    tmux-sessionizer "$workspace"
    local result="$?"
    exit $result
}

main "$@"
