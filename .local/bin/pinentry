#!/bin/sh
set -eu

NIX_BIN="$HOME/.nix-profile/bin"

case "$(uname -s)" in
  Darwin)
    PINENTRY="$NIX_BIN/pinentry-mac"
    ;;
  Linux)
    PINENTRY="$NIX_BIN/pinentry-gnome3"
    ;;
  *)
    echo "Unsupported OS: $(uname -s)" >&2
    exit 1
    ;;
esac

[ -x "$PINENTRY" ] || {
  echo "Nix-managed pinentry is unavailable: $PINENTRY" >&2
  exit 1
}

exec "$PINENTRY" "$@"
# vim: ft=sh
